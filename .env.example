# Copy to .env and fill in. .env is gitignored; never commit it.
# Each machine only needs its own section. Generate secrets with: openssl rand -hex 32
# Phases 1 and 2 may add variables; keep this template in sync.

# ===================== Cluster (login node + GPU job) =====================

# SLURM partition that has the target GPU
SLURM_PARTITION=
# Wall time of the serving job (HH:MM:SS), within the partition's limit
SLURM_TIME=12:00:00
SLURM_CPUS_PER_TASK=16
# Passed as --gres when set. Leave empty where the partition grants the GPU by itself;
# some sites need e.g. gpu:1.
SLURM_GRES=
# Anything else sbatch needs at your site, e.g. --account=... or --nodelist=...
SLURM_EXTRA_ARGS=
# 1 = the job submits its follow-up shortly before SLURM_TIME runs out (off by default)
LLM_AUTO_RESUBMIT=0

# Shared-filesystem directory that holds model weights (outside the repo)
LLM_MODEL_DIR=
# Run files (node and ports per job) and logs; default: $HOME/.local-llm
LLM_RUN_DIR=
# Optional node-local disk to copy weights to at job start (empty = load from LLM_MODEL_DIR)
LLM_STAGE_DIR=
# Hugging Face cache; put it on a large filesystem if $HOME has a small quota
HF_HOME=

# Admin key for the LiteLLM gateway; clients get their own keys
GATEWAY_MASTER_KEY=

# ===================== Laptop =====================

# ssh alias from ~/.ssh/config that can reach the GPU compute node
CLUSTER_SSH_HOST=
# Local end of the SSH tunnel to the gateway
GATEWAY_LOCAL_PORT=4000
# Key the gateway issued for Open WebUI
GATEWAY_API_KEY=

OPENWEBUI_PORT=3000
WEBUI_SECRET_KEY=
SEARXNG_SECRET=
# The ONE folder the assistant may read and write through Open Terminal.
# No SSH keys, tokens, .env files or patient data in it.
OPEN_TERMINAL_DIR=
